{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "cardTitle": {
      "type": "string"
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "dek": {
      "type": "text"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "blogPosts"
    },
    "targetLocation": {
      "type": "string"
    },
    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::person.person",
      "inversedBy": "blogPosts"
    },
    "reviewedBy": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::person.person",
      "inversedBy": "reviewedPosts"
    },
    "datePublished": {
      "type": "date",
      "required": true
    },
    "dateModified": {
      "type": "date",
      "required": true
    },
    "coverImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "required": true
    },
    "coverImageAlt": {
      "type": "string",
      "required": true
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "keyTakeaways": {
      "type": "component",
      "component": "blog.key-takeaway",
      "repeatable": true
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "blog.rich-text",
        "blog.comparison-table",
        "blog.inline-cta"
      ],
      "required": true
    },
    "faq": {
      "type": "component",
      "component": "blog.faq-item",
      "repeatable": true
    },
    "sources": {
      "type": "component",
      "component": "blog.source-item",
      "repeatable": true
    },
    "metaTitle": {
      "type": "string",
      "required": true
    },
    "metaDescription": {
      "type": "text",
      "required": true
    },
    "canonicalUrl": {
      "type": "string"
    },
    "ogTitle": {
      "type": "string"
    },
    "ogDescription": {
      "type": "text"
    },
    "noindex": {
      "type": "boolean",
      "default": false
    }
  }
}
