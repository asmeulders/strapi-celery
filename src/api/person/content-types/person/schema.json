{
  "kind": "collectionType",
  "collectionName": "people",
  "info": {
    "singularName": "person",
    "pluralName": "people",
    "displayName": "Person",
    "description": "A real team member or blog author/reviewer. Linked to the locations they personally service, and to the blog posts they wrote or reviewed — a person gets a /blog/author/<slug> page only if they have at least one. `showOnAbout` controls the About page team roster."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "role": {
      "type": "string",
      "required": true
    },
    "bio": {
      "type": "text",
      "required": true
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "linkedInUrl": {
      "type": "string"
    },
    "basedIn": {
      "type": "string"
    },
    "brokerLicense": {
      "type": "string"
    },
    "sortOrder": {
      "type": "integer"
    },
    "showOnAbout": {
      "type": "boolean",
      "default": false
    },
    "locations": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::location.location",
      "inversedBy": "people"
    },
    "blogPosts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-post.blog-post",
      "mappedBy": "author"
    },
    "reviewedPosts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-post.blog-post",
      "mappedBy": "reviewedBy"
    }
  }
}
